
{
  "compilerOptions": {

    "module": "NodeNext",                                
    "moduleResolution": "NodeNext",                      
    "esModuleInterop": true,                            
    "forceConsistentCasingInFileNames": true,           
    "strict": true,                                      
    "skipLibCheck": true,                                
    "outDir": "./dist",    
    "allowImportingTsExtensions": true,
    "noEmit": true,                         
    
    "rootDir": "./src",                        
    "allowJs": true                      
  },
  "include": ["src/**/*"],      
  "exclude": ["node_modules"]   
}                   